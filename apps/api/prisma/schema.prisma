// The connection URL lives in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

/// A dish or drink on the Menu. Price is integer cents.
model MenuItem {
  id          String @id @db.Uuid
  name        String
  description String
  category    String
  priceCents  Int
}
