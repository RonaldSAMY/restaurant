// The connection URL lives in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

/// A dish or drink on the Menu. Price is integer cents.
model MenuItem {
  id          String @id @db.Uuid
  name        String
  description String
  category    String
  priceCents  Int
  orderItems  OrderItem[]
}

/// Mirrors shared `OrderStatus`.
enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  COLLECTED
}

/// A Guest's Order. `reference` is the Guest-facing id; `id` is never exposed.
model Order {
  id         String      @id @default(uuid()) @db.Uuid
  reference  String      @unique
  guestName  String
  status     OrderStatus
  totalCents Int
  placedAt   DateTime    @db.Timestamptz(3)
  items      OrderItem[]
}

/// One Order line. `name` and `unitPriceCents` are snapshots of the Menu Item;
/// `position` is the 0-based basket order; not unique, because the insert
/// retry reads any P2002 as a reference collision.
model OrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItemId     String   @db.Uuid
  menuItem       MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  name           String
  quantity       Int
  unitPriceCents Int
  position       Int

  @@index([orderId])
  @@index([menuItemId])
}
