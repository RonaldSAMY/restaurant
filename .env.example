# Copy to .env and change the secrets. .env is gitignored.

# postgres container. Changing these after the first start has no effect: the
# postgres-data volume keeps the old credentials; reset with `docker compose down -v`.
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=restaurant

# api, migrate, seed (keep the credentials in sync with the values above;
# percent-encode @ : / # ? % in the password, e.g. p@ss -> p%40ss)
# Compose expands $ in this file: write a literal $ as $$ in any value.
DATABASE_URL=postgresql://restaurant:change-me@postgres:5432/restaurant
REDIS_URL=redis://redis:6379
